<view class="page-container">
  <image class="bg-image" src="/images/wheat-field.jpg" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <view class="custom-nav">
    <view class="nav-back" bindtap="onBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">助教工作台</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="header">
    <view class="welcome">欢迎，{{userInfo.realName || userInfo.username || ''}}</view>
    <view class="role-tag">助教</view>
  </view>

  <view class="glass-card">
    <view class="card-title">班级选择</view>

    <view class="form-item">
      <view class="label">负责班级</view>
      <picker mode="selector" range="{{classOptions}}" value="{{classIndex}}" bindchange="onClassChange">
        <view class="picker-value">
          <text>{{classOptions[classIndex] || '暂无可访问班级'}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="class-preview">
      <text class="preview-label">当前班级</text>
      <text class="preview-name">{{classOptions[classIndex] || '—'}}</text>
    </view>

    <button class="weave-btn" bindtap="onEnterClass">进入班级</button>
  </view>

  <view class="footer-tip">劳动课学时管理 · 助教端</view>
</view>
