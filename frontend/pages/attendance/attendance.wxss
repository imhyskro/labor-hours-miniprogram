/* 容器：min-height + 原生页面滚动，不锁定高度 */
.page-container {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 背景层：fixed 让背景在滚动时保持不动 */
.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%);
  z-index: -1;
}

/* 通用毛玻璃卡片 */
.glass-card {
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 顶部 */
.page-header {
  padding: 48rpx 48rpx 24rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 学生列表（原生滚动，给底部留出键盘高度避免遮挡） */
.student-list {
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
}

/* 发起修改申请按钮条 */
.new-apply-bar {
  padding: 0 32rpx 24rpx;
}

.weave-btn-sm {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.10) 0rpx,
      rgba(255, 255, 255, 0.10) 2rpx,
      transparent 2rpx,
      transparent 8rpx),
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.12) 0rpx,
      rgba(0, 0, 0, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 16rpx rgba(50, 76, 40, 0.35);
}

.weave-btn-sm::after { border: none; }
.weave-btn-sm:active { opacity: 0.88; }

.student-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  transition: all 0.4s;
  border: 2rpx solid transparent;
}

/* 高亮状态（被定位的学生卡片） */
.card-highlight {
  border: 4rpx solid #4A6B3A !important;
  box-shadow: 0 0 24rpx rgba(74, 107, 58, 0.5),
    0 4rpx 16rpx rgba(0, 0, 0, 0.06) !important;
  transform: scale(1.02);
}

.student-info {
  flex: 1;
}

.info-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.info-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d4a1f;
}

/* 已修改标签 */
.modified-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(46, 125, 50, 0.9);
  color: #ffffff;
  border-radius: 16rpx;
}

/* 需审批标签 */
.need-approval-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 152, 0, 0.9);
  color: #ffffff;
  border-radius: 16rpx;
}

.info-id {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.info-meta {
  font-size: 24rpx;
  color: #888888;
}

.meta-sep {
  margin: 0 8rpx;
}

/* 右侧操作 */
.student-ops {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 打分框（只读，点击唤出键盘） */
.score-box {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.2s;
}

.score-active {
  background: rgba(74, 107, 58, 0.15);
  border: 2rpx solid #4A6B3A;
  box-shadow: 0 0 0 4rpx rgba(74, 107, 58, 0.1);
}

.score-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A6B3A;
}

/* 修改按钮（胶囊形） */
.modify-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  background: rgba(74, 107, 58, 0.85);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 28rpx;
}

.modify-btn:active {
  opacity: 0.85;
}

/* 列表底部 */
.list-bottom {
  padding: 24rpx 0 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* ===== 九宫格键盘 ===== */
.keyboard-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.keyboard-panel {
  position: fixed;
  bottom: 0; left: 0;
  width: 100%;
  z-index: 101;
  background-color: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  padding: 32rpx 48rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  transition: transform 0.3s ease;
}

.keyboard-show {
  transform: translateY(0);
}

.keyboard-hide {
  transform: translateY(100%);
  pointer-events: none;
}

.keyboard-title {
  text-align: center;
  font-size: 26rpx;
  color: #2d4a1f;
  margin-bottom: 28rpx;
  font-weight: 500;
}

.keyboard-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.key-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 40rpx;
  font-weight: 600;
  user-select: none;
}

/* 深绿织布纹理按键 */
.weave-key {
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.10) 0rpx,
      rgba(255, 255, 255, 0.10) 2rpx,
      transparent 2rpx,
      transparent 8rpx),
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.12) 0rpx,
      rgba(0, 0, 0, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(50, 76, 40, 0.35),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15);
}

.weave-key:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* 删除键 */
.key-del {
  background-color: rgba(158, 158, 158, 0.85);
  color: #ffffff;
  font-size: 32rpx;
}

.key-del:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 确认键（深绿织布纹理，跨3列） */
.key-confirm {
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.12) 0rpx,
      rgba(255, 255, 255, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx),
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.14) 0rpx,
      rgba(0, 0, 0, 0.14) 2rpx,
      transparent 2rpx,
      transparent 8rpx);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  grid-column: span 3;
  box-shadow: 0 6rpx 16rpx rgba(50, 76, 40, 0.45),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15);
}

.key-confirm:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* 缓冲预览 */
.buffer-preview {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.buffer-label {
  font-size: 26rpx;
  color: #666666;
}

.buffer-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A6B3A;
}
