<view class="page-container">
  <!-- 背景层 -->
  <image class="bg-image" src="/images/wheat-field.jpg" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="page-title">编辑修改申请</view>
    <view class="page-sub" wx:if="{{studentId}}">{{studentName}}（{{studentId}}）</view>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card glass-card">
    <!-- 学生信息预填（只读展示） -->
    <view class="form-item" wx:if="{{studentId}}">
      <view class="label">学生信息</view>
      <view class="readonly-row">
        <text class="readonly-text">{{studentName}}</text>
        <text class="readonly-sep">·</text>
        <text class="readonly-text">{{studentId}}</text>
      </view>
    </view>

    <view class="form-item" wx:if="{{originScore}}">
      <view class="label">原考勤</view>
      <view class="readonly-row">
        <text class="readonly-text score-badge">{{originScore}}</text>
      </view>
    </view>

    <!-- 选择老师 -->
    <view class="form-item">
      <view class="label">选择老师</view>
      <picker mode="selector" range="{{teacherList}}" value="{{teacherIndex}}" bindchange="onTeacherChange">
        <view class="picker-value">
          <text>{{teacherList[teacherIndex]}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 申请理由 -->
    <view class="form-item">
      <view class="label">申请理由</view>
      <textarea class="textarea"
                placeholder="请详细说明修改考勤的原因..."
                value="{{applyReason}}"
                bindinput="onReasonInput"
                maxlength="200"
                auto-height></textarea>
      <view class="char-count">{{applyReason.length}}/200</view>
    </view>

    <!-- 上传假条 -->
    <view class="form-item">
      <view class="label">上传假条凭证</view>
      <view class="image-grid">
        <!-- 已选图片 -->
        <view class="image-item" wx:for="{{images}}" wx:key="*this">
          <image class="preview-img"
                 src="{{item}}"
                 mode="aspectFill"
                 data-url="{{item}}"
                 bindtap="onPreviewImage"></image>
          <view class="delete-icon" data-idx="{{index}}" catchtap="onDeleteImage">×</view>
        </view>
        <!-- + 号占位 -->
        <view class="add-box" wx:if="{{images.length < maxImages}}" bindtap="onChooseImage">
          <view class="add-icon">+</view>
          <view class="add-text">上传假条</view>
        </view>
      </view>
      <view class="upload-tip">最多上传 {{maxImages}} 张，支持相册或拍照</view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="weave-btn" bindtap="onSubmit">确定发送申请</button>
  </view>
</view>
