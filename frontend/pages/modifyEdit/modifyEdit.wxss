.page-container {
  position: relative;
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 背景层 */
.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%);
  z-index: -1;
}

/* 通用毛玻璃卡片 */
.glass-card {
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 顶部 */
.page-header {
  padding: 48rpx 0 32rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 表单卡片 */
.form-card {
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 14rpx;
  font-weight: 500;
}

/* 只读信息行 */
.readonly-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  box-sizing: border-box;
}

.readonly-text {
  font-size: 32rpx;
  color: #333333;
}

.readonly-sep {
  color: #999999;
}

.score-badge {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A6B3A;
}

/* 选择器 */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
}

.arrow {
  color: #999999;
  font-size: 36rpx;
}

/* 多行文本框 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 图片上传网格 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 14rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 14rpx;
  box-sizing: border-box;
}

.delete-icon {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.add-box {
  width: 100%;
  aspect-ratio: 1;
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx dashed rgba(255, 255, 255, 0.6);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.add-box:active {
  background: rgba(255, 255, 255, 0.55);
}

.add-icon {
  font-size: 48rpx;
  color: #4A6B3A;
  font-weight: 300;
}

.add-text {
  font-size: 24rpx;
  color: #666666;
}

.upload-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 底部按钮 */
.bottom-bar {
  padding: 16rpx 0 60rpx;
}

/* 深绿色织布纹理按钮 */
.weave-btn {
  width: 100%;
  height: 96rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.10) 0rpx,
      rgba(255, 255, 255, 0.10) 2rpx,
      transparent 2rpx,
      transparent 8rpx),
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.12) 0rpx,
      rgba(0, 0, 0, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(50, 76, 40, 0.45),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15);
}

.weave-btn::after { border: none; }
.weave-btn:active { opacity: 0.88; transform: scale(0.99); }
