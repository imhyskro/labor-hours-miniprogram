.page-container { position: relative; min-height: 100vh; padding: 0 32rpx; box-sizing: border-box; display: flex; flex-direction: column; padding-bottom: 140rpx; }
.bg-image { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; }
.bg-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%); z-index: -1; }
.custom-nav { display: flex; align-items: center; justify-content: space-between; padding: 60rpx 32rpx 20rpx; }
.nav-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.4); border-radius: 50%; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
.back-icon { font-size: 44rpx; font-weight: 700; color: #fff; line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.nav-placeholder { width: 60rpx; }
.glass-card { background-color: rgba(255,255,255,0.25); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.4); border-radius: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.filter-card { margin: 20rpx 0; padding: 24rpx 28rpx; }
.filter-label { font-size: 26rpx; color: #2d4a1f; margin-bottom: 14rpx; font-weight: 500; }
.picker-value { display: flex; align-items: center; justify-content: space-between; height: 72rpx; padding: 0 24rpx; background: rgba(255,255,255,0.7); border-radius: 12rpx; font-size: 28rpx; color: #333; }
.arrow { color: #999; font-size: 32rpx; }
.current-binding { margin-top: 16rpx; font-size: 24rpx; color: #666; }
.binding-name { color: #4A6B3A; font-weight: 600; }
.teacher-card { margin-top: 20rpx; padding: 24rpx 28rpx; flex: 1; }
.list-title { font-size: 28rpx; font-weight: 600; color: #2d4a1f; margin-bottom: 20rpx; }
.teacher-list { display: flex; flex-direction: column; gap: 16rpx; }
.teacher-item { display: flex; align-items: center; padding: 20rpx 24rpx; background: rgba(255,255,255,0.6); border-radius: 14rpx; border: 2rpx solid transparent; }
.teacher-item.selected { border-color: #4A6B3A; background: rgba(74,107,58,0.1); }
.ck { margin-right: 20rpx; transform: scale(0.9); }
.t-name { font-size: 28rpx; color: #333; }
.empty-tip { padding: 40rpx; text-align: center; font-size: 28rpx; color: #888; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx 40rpx; background: rgba(255,255,255,0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
.weave-btn { width: 100%; height: 88rpx; line-height: 88rpx; background: #4A6B3A; color: #fff; font-size: 30rpx; font-weight: 600; border-radius: 44rpx; text-align: center; }