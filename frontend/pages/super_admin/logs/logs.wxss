.page-container { position: relative; min-height: 100vh; padding: 0 32rpx; box-sizing: border-box; display: flex; flex-direction: column; padding-bottom: 60rpx; }
.bg-image { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; }
.bg-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%); z-index: -1; }
.custom-nav { display: flex; align-items: center; justify-content: space-between; padding: 60rpx 32rpx 20rpx; }
.nav-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.4); border-radius: 50%; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
.back-icon { font-size: 44rpx; font-weight: 700; color: #fff; line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.nav-placeholder { width: 60rpx; }
.glass-card { background-color: rgba(255,255,255,0.25); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.4); border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.timeline { display: flex; flex-direction: column; padding: 20rpx 0; }
.tl-item { display: flex; align-items: stretch; margin-bottom: 24rpx; }
.tl-left { display: flex; flex-direction: column; align-items: center; width: 40rpx; padding-top: 28rpx; }
.tl-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #4A6B3A; flex-shrink: 0; }
.tl-line { width: 2rpx; flex: 1; background: rgba(74,107,58,0.3); margin-top: 8rpx; }
.tl-card { flex: 1; margin-left: 20rpx; padding: 24rpx 28rpx; }
.tl-summary { font-size: 28rpx; font-weight: 700; color: #2d4a1f; margin-bottom: 10rpx; }
.tl-detail { font-size: 22rpx; color: #888; margin-bottom: 10rpx; }
.tl-operator { display: inline-block; font-size: 22rpx; color: #4A6B3A; background: rgba(74,107,58,0.12); padding: 4rpx 16rpx; border-radius: 16rpx; }
.empty-tip { padding: 120rpx 0; text-align: center; font-size: 28rpx; color: rgba(255,255,255,0.8); }
.footer-tip { margin-top: auto; padding: 40rpx 0; text-align: center; font-size: 22rpx; color: rgba(255,255,255,0.7); text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3); }