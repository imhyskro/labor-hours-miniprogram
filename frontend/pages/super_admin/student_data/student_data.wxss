.page-container { position: relative; height: 100vh; padding: 0 24rpx; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; }
.bg-image { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; }
.bg-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%); z-index: -1; }
.custom-nav { display: flex; align-items: center; justify-content: space-between; padding: 60rpx 8rpx 20rpx; background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 100%); margin: 0 -24rpx; padding-left: 32rpx; padding-right: 32rpx; }
.nav-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.4); border-radius: 50%; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
.back-icon { font-size: 44rpx; font-weight: 700; color: #fff; line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.nav-placeholder { width: 60rpx; }
.glass-card { background-color: rgba(255,255,255,0.25); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.4); border-radius: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.toolbar { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx; }
.search-box { flex: 1; display: flex; align-items: center; background: rgba(255,255,255,0.7); border-radius: 12rpx; padding: 0 20rpx; height: 72rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #333; }
.tool-btns { display: flex; gap: 12rpx; }
.tool-btn { padding: 0 24rpx; height: 72rpx; line-height: 72rpx; font-size: 26rpx; border-radius: 12rpx; color: #fff; }
.import-btn { background: #4A6B3A; }
.export-btn { background: #6B7280; }
.add-btn { background: #2563EB; }
.table-wrap { flex: 1; padding: 0; overflow: hidden; min-height: 0; }
.table-inner { min-width: 1040rpx; height: 100%; }
.t-row { display: flex; align-items: center; }
.t-head { background: rgba(74,107,58,0.12); }
.t-cell { padding: 24rpx 20rpx; font-size: 26rpx; color: #333; border-bottom: 1px solid rgba(0,0,0,0.04); white-space: nowrap; box-sizing: border-box; }
.t-head .t-cell { font-weight: 700; color: #2d4a1f; }
.c-name { width: 140rpx; }
.c-code { width: 180rpx; }
.c-college { width: 160rpx; }
.c-major { width: 180rpx; }
.c-class { width: 180rpx; }
.c-status { width: 100rpx; }
.c-act { width: 200rpx; display: flex; gap: 10rpx; }
.c-hours { width: 140rpx; }
.c-score { width: 120rpx; }
.row-btn { height: 48rpx; line-height: 48rpx; padding: 0 16rpx; font-size: 22rpx; border-radius: 24rpx; color: #fff; }
.row-btn.edit { background: #4A6B3A; }
.row-btn.del { background: #C93E39; }
.empty-row { padding: 60rpx; text-align: center; font-size: 26rpx; color: #999; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 100; }
.modal-panel { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 620rpx; max-height: 80vh; overflow-y: auto; background: #fff; border-radius: 24rpx; padding: 40rpx; z-index: 101; }
.modal-show { opacity: 1; }
.modal-hide { opacity: 0; pointer-events: none; }
.modal-title { font-size: 32rpx; font-weight: 600; color: #2d4a1f; text-align: center; margin-bottom: 20rpx; }
.modal-field { margin-bottom: 20rpx; }
.modal-label { font-size: 26rpx; color: #333; display: block; margin-bottom: 8rpx; }
.modal-input { height: 76rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; }
.modal-picker { height: 76rpx; line-height: 76rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; display: flex; justify-content: space-between; align-items: center; }
.modal-picker .arrow { font-size: 32rpx; color: #4A6B3A; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.modal-btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 28rpx; }
.cancel { background: #f5f5f5; color: #666; }
.confirm { background: #4A6B3A; color: #fff; }