.page-container {
  position: relative;
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%);
  z-index: -1;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 20rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.back-icon {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.nav-placeholder {
  width: 60rpx;
}

.header {
  padding: 20rpx 0 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
}

.welcome {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.role-tag {
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(74, 107, 58, 0.8);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.glass-card {
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
  
.card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
}

.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(74, 107, 58, 0.15);
  margin-right: 28rpx;
  flex-shrink: 0;
}

.emoji-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.card-text {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d4a1f;
  margin-bottom: 6rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #888888;
}

.card-arrow {
  font-size: 40rpx;
  color: #bbbbbb;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.menu-card:active {
  opacity: 0.85;
}

.footer-tip {
  margin-top: auto;
  padding: 60rpx 0 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}