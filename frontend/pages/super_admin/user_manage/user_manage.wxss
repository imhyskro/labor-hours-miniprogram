.page-container { position: relative; min-height: 100vh; padding: 0 32rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.bg-image { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; }
.bg-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%); z-index: -1; }
.custom-nav { display: flex; align-items: center; justify-content: space-between; padding: 60rpx 32rpx 20rpx; }
.nav-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.4); border-radius: 50%; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
.back-icon { font-size: 44rpx; font-weight: 700; color: #fff; line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.nav-placeholder { width: 60rpx; }
.glass-card { background-color: rgba(255,255,255,0.25); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.4); border-radius: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.filter-card { margin: 20rpx 0; padding: 24rpx; }
.search-input { width: 100%; height: 72rpx; padding: 0 24rpx; background: rgba(255,255,255,0.7); border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; margin-bottom: 20rpx; }
.role-tabs { display: flex; gap: 16rpx; }
.tab-item { flex: 1; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 26rpx; border-radius: 30rpx; background: rgba(255,255,255,0.5); color: #666; }
.tab-active { background: #4A6B3A; color: #fff; }
.user-list { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 40rpx; }
.user-card { padding: 28rpx 32rpx; }
.user-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.user-name { font-size: 34rpx; font-weight: 700; color: #2d4a1f; }
.role-tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 16rpx; color: #fff; }
.tag-teacher { background: rgba(230,126,34,0.85); }
.tag-assistant { background: rgba(74,107,58,0.85); }
.tag-super_admin { background: rgba(229,57,53,0.85); }
.user-meta { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.user-meta.tiny { font-size: 22rpx; color: #999; }
.user-ops { display: flex; gap: 16rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1px solid rgba(0,0,0,0.05); }
.op-btn { padding: 10rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; color: #fff; }
.op-enable { background: #4A6B3A; }
.op-disable { background: #E53935; }
.op-reset { background: rgba(158,158,158,0.85); }
.op-detail { background: #2563EB; }
.empty-card { margin: 80rpx 0; padding: 80rpx; text-align: center; font-size: 28rpx; color: #888; }

/* 详情弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 100; }
.modal-panel { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 600rpx; background: #fff; border-radius: 24rpx; padding: 40rpx; z-index: 101; }
.modal-show { opacity: 1; }
.modal-hide { opacity: 0; pointer-events: none; }
.modal-title { font-size: 32rpx; font-weight: 600; color: #2d4a1f; text-align: center; margin-bottom: 24rpx; }
.detail-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.dl-label { font-size: 26rpx; color: #888; }
.dl-val { font-size: 26rpx; color: #333; font-weight: 500; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.modal-btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 28rpx; }
.modal-btn.confirm { background: #4A6B3A; color: #fff; }
.create-btn { height: 72rpx; line-height: 72rpx; text-align: center; margin-top: 20rpx; background: #4A6B3A; color: #fff; font-size: 26rpx; border-radius: 16rpx; }