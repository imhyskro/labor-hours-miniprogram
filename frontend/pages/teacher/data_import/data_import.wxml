<view class="page-container">
  <image class="bg-image" src="/images/wheat-field.jpg" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <view class="custom-nav">
    <view class="nav-back" bindtap="onBack"><text class="back-icon">‹</text></view>
    <view class="nav-title">数据导入</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="import-card glass-card">
    <view class="import-title">批量数据导入</view>
    <view class="import-desc">支持 Excel 文件导入，导入后将自动同步至后端数据库</view>

    <view class="import-btn weave-btn" bindtap="onImportStudents">
      <text class="btn-emoji">📋</text>
      <view class="btn-text">
        <view class="btn-title">导入学生数据</view>
        <view class="btn-sub">需使用对应模板</view>
      </view>
    </view>

    <view class="import-btn weave-btn" bindtap="onImportAssistants">
      <text class="btn-emoji">👨‍🏫</text>
      <view class="btn-text">
        <view class="btn-title">导入助教数据</view>
        <view class="btn-sub">需使用对应模板</view>
      </view>
    </view>

    <view class="import-tip">
      <view class="tip-title">📄 模板下载</view>
      <view class="tip-line tpl-btn" bindtap="onDownloadStudentTemplate">• 下载学生导入模板</view>
      <view class="tip-line tpl-btn" bindtap="onDownloadAssistantTemplate">• 下载助教导入模板</view>
    </view>

    <view class="import-tip">
      <view class="tip-title">📝 模板列说明</view>
      <view class="tip-line">• 学生表：学号、姓名、公司名称、周次、开始节次、结束节次、班内编号、原始专业、性别(男/女)</view>
      <view class="tip-line">• 助教表：学号、姓名、公司名称、周次、开始节次、结束节次、班内编号、原始专业</view>
    </view>
  </view>
</view>
