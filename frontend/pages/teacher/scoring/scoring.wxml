<view class="page-container">
  <image class="bg-image" src="/images/wheat-field.jpg" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <view class="custom-nav">
    <view class="nav-back" bindtap="onBack"><text class="back-icon">‹</text></view>
    <view class="nav-title">学生打分</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar glass-card">
    <picker mode="selector" range="{{classOptions}}" value="{{classIndex}}" bindchange="onClassChange">
      <view class="filter-item">
        <text class="filter-label">班级</text>
        <text class="filter-value">{{classOptions[classIndex] || '暂无'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <picker mode="selector" range="{{sessionOptions}}" value="{{sessionIndex}}" bindchange="onSessionChange">
      <view class="filter-item">
        <text class="filter-label">课次</text>
        <text class="filter-value">{{sessionOptions[sessionIndex] || '暂无'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 批量保存按钮 -->
  <view class="batch-bar" wx:if="{{students.length}}">
    <view class="batch-info">共 {{students.length}} 名学生</view>
    <view class="batch-btn" bindtap="onSaveAll">批量保存</view>
  </view>

  <!-- 学生打分列表 -->
  <view class="score-list">
    <view class="score-card glass-card" wx:for="{{students}}" wx:key="id">
      <view class="student-info">
        <view class="student-name">{{item.name}}</view>
        <view class="student-no">学号 {{item.studentNo}}</view>
        <view class="student-no" wx:if="{{item.studentNoInClass}}">班内编号 {{item.studentNoInClass}}</view>
      </view>
      <view class="score-fields">
        <view class="field-row">
          <text class="field-label">类型</text>
          <picker mode="selector" range="{{['正常','事假','旷课']}}"
                  value="{{item.attendanceType === 'J' ? 1 : (item.attendanceType === 'K' ? 2 : 0)}}"
                  data-idx="{{index}}" bindchange="onTypeChange">
            <view class="type-picker {{item.attendanceType}}">
              <text>{{item.displayType}}</text>
              <text class="arrow">›</text>
            </view>
          </picker>
        </view>
        <view class="field-row">
          <text class="field-label">分数</text>
          <input class="score-input" type="digit" value="{{item.score}}"
                 data-idx="{{index}}" bindinput="onScoreInput"
                 placeholder="0-10" maxlength="4" />
        </view>
        <view class="field-row">
          <text class="field-label">备注</text>
          <input class="remark-input" value="{{item.remark}}"
                 data-idx="{{index}}" bindinput="onRemarkInput"
                 placeholder="选填" />
        </view>
        <view class="save-one-btn" data-idx="{{index}}" bindtap="onSaveOne">保存</view>
      </view>
    </view>
    <view class="list-bottom" wx:if="{{students.length}}">共 {{students.length}} 名学生</view>
    <view class="list-bottom" wx:else>请选择班级和课次</view>
  </view>
</view>
