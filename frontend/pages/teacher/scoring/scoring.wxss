.page-container { min-height: 100vh; position: relative; }
.bg-image { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; }
.bg-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%); z-index: -1; }
page { padding-bottom: 60rpx; }

/* 自定义导航 */
.custom-nav { display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; height: 88rpx; margin-top: env(safe-area-inset-top); position: relative; z-index: 1; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 56rpx; color: #fff; font-weight: 300; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; }
.nav-placeholder { width: 64rpx; }

/* 毛玻璃 */
.glass-card { background-color: rgba(255,255,255,0.25); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.4); border-radius: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }

/* 筛选栏 */
.filter-bar { margin: 24rpx 32rpx; padding: 20rpx 28rpx; display: flex; align-items: center; gap: 28rpx; }
.filter-item { display: flex; align-items: center; gap: 8rpx; }
.filter-label { font-size: 24rpx; color: #666; }
.filter-value { font-size: 26rpx; color: #2d4a1f; font-weight: 500; }
.arrow { font-size: 32rpx; color: #4A6B3A; }

/* 批量保存栏 */
.batch-bar { display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; margin-bottom: 16rpx; }
.batch-info { font-size: 24rpx; color: #666; }
.batch-btn { height: 60rpx; line-height: 60rpx; padding: 0 32rpx; background: #4A6B3A; color: #fff; font-size: 26rpx; border-radius: 30rpx; }

/* 打分列表 */
.score-list { padding: 0 32rpx; }
.score-card { display: flex; padding: 24rpx; margin-bottom: 16rpx; }
.student-info { width: 180rpx; flex-shrink: 0; }
.student-name { font-size: 30rpx; font-weight: 600; color: #2d4a1f; }
.student-no { font-size: 20rpx; color: #888; margin-top: 6rpx; }

.score-fields { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.field-row { display: flex; align-items: center; gap: 12rpx; }
.field-label { font-size: 24rpx; color: #666; width: 56rpx; flex-shrink: 0; }
.type-picker { height: 56rpx; line-height: 56rpx; padding: 0 16rpx; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 24rpx; display: flex; align-items: center; gap: 8rpx; min-width: 120rpx; }
.type-picker.NORMAL { color: #4A6B3A; }
.type-picker.J { color: #E5A100; border-color: #E5A100; }
.type-picker.K { color: #C93E39; border-color: #C93E39; }
.score-input { height: 56rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 0 16rpx; font-size: 28rpx; width: 120rpx; text-align: center; }
.remark-input { height: 56rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 0 16rpx; font-size: 24rpx; flex: 1; }
.save-one-btn { align-self: flex-end; height: 48rpx; line-height: 48rpx; padding: 0 20rpx; background: #4A6B3A; color: #fff; font-size: 22rpx; border-radius: 24rpx; }
.list-bottom { text-align: center; color: #999; font-size: 24rpx; padding: 32rpx 0; }
