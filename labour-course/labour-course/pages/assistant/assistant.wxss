.page-container {
  position: relative;
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 背景层 */
.bg-image {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%);
  z-index: -1;
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 20rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.back-icon {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.nav-placeholder {
  width: 60rpx;
}

/* 顶部欢迎语 */
.header {
  padding-top: 40rpx;
  padding-bottom: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
}

.welcome {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.role-tag {
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(74, 107, 58, 0.8);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 毛玻璃卡片 */
.glass-card {
  margin-top: 20rpx;
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  padding: 56rpx 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d4a1f;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 36rpx;
}

.label {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
}

.arrow {
  color: #999999;
  font-size: 36rpx;
}

/* 班级预览卡片 */
.class-preview {
  position: relative;
  margin: 30rpx 0 40rpx;
  padding: 28rpx 30rpx;
  background: rgba(74, 107, 58, 0.12);
  border-radius: 16rpx;
}
.preview-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d4a1f;
  margin-bottom: 10rpx;
}
.preview-meta {
  font-size: 24rpx;
  color: rgba(46, 61, 36, 0.7);
  margin-bottom: 16rpx;
}
.preview-status {
  font-size: 24rpx;
  padding: 6rpx 0;
}
.preview-status.pending {
  color: #E53935;
}
.preview-status.done {
  color: rgba(74, 107, 58, 0.7);
}
/* picker 选项内嵌红点 */
.picker-text-wrap {
  display: flex;
  align-items: center;
}

/* 深绿色织布纹理按钮（共享样式） */
.weave-btn {
  position: relative;
  width: 100%;
  height: 96rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.10) 0rpx,
      rgba(255, 255, 255, 0.10) 2rpx,
      transparent 2rpx,
      transparent 8rpx),
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.12) 0rpx,
      rgba(0, 0, 0, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(50, 76, 40, 0.45),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15);
}

.weave-btn::after { border: none; }
.weave-btn:active { opacity: 0.88; transform: scale(0.99); }

/* 提示文案 + 空状态 */
.card-sub {
  font-size: 24rpx;
  color: rgba(74, 107, 58, 0.85);
  margin-bottom: 20rpx;
}
.empty-tip {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(46, 61, 36, 0.6);
}
/* 红点提醒（内联，适配 picker 选项） */
.pending-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #E53935;
  box-shadow: 0 0 0 4rpx rgba(229, 57, 53, 0.25);
  margin-right: 12rpx;
  vertical-align: middle;
}

/* 自定义滑动选择器弹层 */
.picker-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s;
  z-index: 100;
}
.picker-mask.show {
  opacity: 1;
  visibility: visible;
}
.picker-panel {
  position: fixed;
  bottom: 0; left: 0;
  width: 100%;
  max-height: 70vh;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.28s ease;
  z-index: 101;
  display: flex;
  flex-direction: column;
}
.picker-panel.show {
  transform: translateY(0);
}
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}
.picker-cancel {
  font-size: 30rpx;
  color: #999;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d4a1f;
}
.picker-ok {
  font-size: 30rpx;
  color: #4A6B3A;
  font-weight: 600;
}
.picker-scroll {
  max-height: 60vh;
  padding: 8rpx 0;
}
.picker-option {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}
.picker-option.active {
  background: rgba(74, 107, 58, 0.1);
}
.picker-option:active {
  background: rgba(74, 107, 58, 0.06);
}
.option-main {
  flex: 1;
  min-width: 0;
}
.option-name {
  font-size: 32rpx;
  color: #2d4a1f;
  display: block;
  margin-bottom: 6rpx;
}
.option-meta {
  font-size: 24rpx;
  color: rgba(46, 61, 36, 0.6);
}
/* 弹层内红点（固定位置，不占文本流） */
.picker-option .pending-dot {
  display: block;
  width: 20rpx;
  height: 20rpx;
  margin-right: 0;
  margin-left: 16rpx;
}
.option-check {
  font-size: 36rpx;
  color: #4A6B3A;
  margin-left: 16rpx;
}

/* 底部 */
.footer-tip {
  margin-top: auto;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}
