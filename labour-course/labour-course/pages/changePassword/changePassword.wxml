<view class="page-container">
  <!-- 背景层 -->
  <image class="bg-image" src="/images/wheat-field.jpg" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="page-title">首次登录请修改密码</view>
    <view class="page-sub">{{firstLogin ? '首次登录，请修改初始密码' : '请输入原密码与新密码'}}</view>
  </view>

  <!-- 表单卡片：毛玻璃 -->
  <view class="form-card glass-card">
    <!-- 原密码 -->
    <view class="form-item">
      <view class="label">旧密码</view>
      <input class="input"
             type="password"
             placeholder="请输入原密码"
             placeholder-style="font-size: 24rpx; color: #999999;"
             value="{{oldPwd}}"
             bindinput="onOldPwdInput" />
    </view>

    <!-- 新密码 -->
    <view class="form-item">
      <view class="label">新密码</view>
      <input class="input"
             type="password"
             placeholder="请输入新密码"
             placeholder-style="font-size: 24rpx; color: #999999;"
             value="{{newPwd}}"
             bindinput="onNewPwdInput" />
      <view class="hint">至少8位，且包含大写、小写、数字、特殊字符(@$!%*?&)中至少三类</view>
    </view>

    <!-- 确认密码 -->
    <view class="form-item">
      <view class="label">确认新密码</view>
      <input class="input"
             type="password"
             placeholder="请再次输入新密码"
             placeholder-style="font-size: 24rpx; color: #999999;"
             value="{{confirmPwd}}"
             bindinput="onConfirmPwdInput" />
    </view>

    <!-- 修改密码按钮：深绿色织布纹理 -->
    <button class="weave-btn" bindtap="onChangePwd">确认修改</button>
  </view>

  <view class="footer-tip">仅供高校教学管理使用</view>
</view>
