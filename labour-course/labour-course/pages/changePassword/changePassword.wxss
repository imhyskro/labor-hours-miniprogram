.page-container {
  position: relative;
  min-height: 100vh;
  padding: 0 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 背景层 */
.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%);
  z-index: -1;
}

/* 顶部标题 */
.page-header {
  padding-top: 140rpx;
  padding-bottom: 60rpx;
  text-align: center;
  color: #ffffff;
}

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.page-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 表单卡片：磨砂玻璃 */
.glass-card {
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-card {
  padding: 64rpx 48rpx;
}

.form-item {
  margin-bottom: 44rpx;
}

.label {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 14rpx;
  font-weight: 500;
}

/* 输入框 */
.input {
  height: 88rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 校验提示 */
.hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4A7C9B;
}

/* 底部按钮：深绿色 + 麻布编织纹理 */
.weave-btn {
  position: relative;
  width: 100%;
  height: 96rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.10) 0rpx,
      rgba(255, 255, 255, 0.10) 2rpx,
      transparent 2rpx,
      transparent 8rpx
    ),
    repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.12) 0rpx,
      rgba(0, 0, 0, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx
    );
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 8rpx;
  box-shadow:
    0 8rpx 24rpx rgba(50, 76, 40, 0.45),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15);
}

.weave-btn::after {
  border: none;
}

.weave-btn:active {
  opacity: 0.88;
  transform: scale(0.99);
}

/* 底部版权 */
.footer-tip {
  margin-top: auto;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}
