.page-container {
  position: relative;
  min-height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 背景层 */
.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.15) 100%);
  z-index: -1;
}

/* 顶部标题 */
.page-header {
  padding: 48rpx 0 24rpx;
  text-align: center;
  color: #ffffff;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 毛玻璃卡片 */
.glass-card {
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 列表容器 */
.score-list {
  flex: 1;
  padding-bottom: 60rpx;
}

/* 单条待打分卡片 */
.score-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
}

.score-card:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.card-main {
  flex: 1;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d4a1f;
  margin-bottom: 10rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.meta-sep {
  margin: 0 8rpx;
}

.meta-date {
  color: #4A6B3A;
}

.card-footer {
  display: flex;
  align-items: center;
}

.unscored-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: rgba(255, 152, 0, 0.9);
  color: #ffffff;
  border-radius: 16rpx;
}

/* 去打分按钮 */
.card-action {
  margin-left: 24rpx;
}

.go-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background-color: #4A6B3A;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.10) 0rpx,
      rgba(255, 255, 255, 0.10) 2rpx,
      transparent 2rpx,
      transparent 8rpx),
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.12) 0rpx,
      rgba(0, 0, 0, 0.12) 2rpx,
      transparent 2rpx,
      transparent 8rpx);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(50, 76, 40, 0.35);
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 120rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  font-size: 56rpx;
  color: #4A6B3A;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 底部版权 */
.footer-tip {
  margin-top: auto;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}
